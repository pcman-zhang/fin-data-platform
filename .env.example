# 本地配置模板：复制为 .env（已被 .gitignore 忽略），凭证不入库。
# PostgreSQL + TimescaleDB（docker-compose.dev.yml）
POSTGRES_USER=fdp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fin_data_platform
# 全栈编排（docker-compose.yml）数据库端口
POSTGRES_PORT=5432
# 开发数据库（docker-compose.dev.yml）端口，默认退避避免冲突
DEV_POSTGRES_PORT=15432
# 仅本机访问数据库时解开（默认对所有接口开放）
# POSTGRES_BIND=127.0.0.1
# DEV_POSTGRES_BIND=127.0.0.1

# 集成测试（pytest -m integration）与迁移所用连接（与 compose 保持一致）
DATABASE_USER=fdp
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=fin_data_platform
# 连接超时（秒，可选；容器内网络不可达时快速失败）
# DATABASE_CONNECT_TIMEOUT=5

# 缓存（L1 进程内 + L2 Redis）：未设置 FDP_REDIS_URL 则不启用缓存
# FDP_REDIS_URL=redis://redis:6379/0
# FDP_CACHE_TTL=21600
REDIS_PORT=6379
REDIS_MAXMEMORY=2gb
# Redis 无鉴权：默认仅本机监听；确需外部访问再放开
# REDIS_BIND=0.0.0.0

# 读写 DSN 分离（可选）：只读登录用户（继承只读权限角色 fdp_ro；密码自行创建）
# DATABASE_READ_USER=app_ro
# DATABASE_READ_PASSWORD=change-me

# 管理 API / WebUI（service 服务）：默认仅本机
API_PORT=8000
# API_BIND=0.0.0.0

# 容器化部署（docker compose up -d）按需填写；未配置时不装配同步任务
# TUSHARE_TOKEN=
# FDP_SYNC_CODES=600519.SH,000001.SZ
# FDP_SYNC_START=2026-09-01
# FDP_SYNC_SOURCE=tushare
# FDP_SYNC_SCHEDULE=0 9 * * 1-5
# 派生物化调度（仅 materialize=latest 且 refresh=scheduled 的派生；cron 或 interval:<秒>）
# FDP_DERIVE_SCHEDULE=0 10 * * 1-5
